# Model access. Copy to .env and fill in; .env is gitignored.
#
# No value belongs in this file. It documents which variables exist, nothing
# more — a committed example with a real key in it is the failure this file is
# shaped to avoid, and tests/models/env-example.test.ts asserts it stays empty.

# Required. The API key oMLX expects on /v1.
OMLX_API_KEY=

# Optional. Defaults are in src/models/config.ts.
# The host must be on this machine; the adapter rejects anything else.
OMLX_BASE_URL=
OMLX_MODEL=

# Optional. Frontier providers, read only when a command names one with a
# model flag and --spend. A key here never chooses a model: nothing runs on a
# paid API unless the command line says so.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
